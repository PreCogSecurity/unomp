# UNOMP Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# Portal Configuration
# =============================================================================

# Log level: debug, warning, error, special
LOG_LEVEL=debug

# Enable colored console output (disable for log files)
LOG_COLORS=true

# Enable JSON structured logging (for production/log aggregation)
LOG_JSON=false

# Log file path (optional, for file-based logging)
LOG_FILE=

# CLI listener port (for blocknotify, admin commands)
CLI_PORT=17117

# Clustering configuration
CLUSTERING_ENABLED=true
CLUSTERING_FORKS=auto  # or a number

# =============================================================================
# Redis Configuration (Portal-level)
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Leave empty for no password, or set a strong password

# =============================================================================
# Website Configuration
# =============================================================================
WEBSITE_ENABLED=true
WEBSITE_HOST=0.0.0.0
WEBSITE_PORT=80
WEBSITE_SITE_TITLE=UNOMP
WEBSITE_STRATUM_HOST=stratum.example.com

# Website stats configuration
WEBSITE_STATS_UPDATE_INTERVAL=15
WEBSITE_STATS_HISTORICAL_RETENTION=43200
WEBSITE_STATS_HASHRATE_WINDOW=300

# Admin center (CHANGE THE DEFAULT PASSWORD!)
WEBSITE_ADMIN_ENABLED=true
WEBSITE_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# =============================================================================
# Default Pool Configuration (inherited by pool configs if not overridden)
# =============================================================================
DEFAULT_BLOCK_REFRESH_INTERVAL=1000
DEFAULT_JOB_REBROADCAST_TIMEOUT=55
DEFAULT_CONNECTION_TIMEOUT=600
DEFAULT_EMIT_INVALID_BLOCK_HASHES=false
DEFAULT_VALIDATE_WORKER_USERNAME=true
DEFAULT_TCP_PROXY_PROTOCOL=false

# Banning configuration
DEFAULT_BANNING_ENABLED=true
DEFAULT_BANNING_TIME=600
DEFAULT_BANNING_INVALID_PERCENT=50
DEFAULT_BANNING_CHECK_THRESHOLD=500
DEFAULT_BANNING_PURGE_INTERVAL=300

# Default Redis for pools
DEFAULT_REDIS_HOST=127.0.0.1
DEFAULT_REDIS_PORT=6379
DEFAULT_REDIS_DB=0
DEFAULT_REDIS_PASSWORD=

# =============================================================================
# Switching Configuration (Algorithm-based auto-switching ports)
# =============================================================================
# Example for SHA256 switching port
# SWITCHING_SWITCH1_ENABLED=false
# SWITCHING_SWITCH1_ALGORITHM=sha256
# SWITCHING_SWITCH1_PORT_3333_DIFF=10
# SWITCHING_SWITCH1_PORT_3333_VARDIF_MIN=16
# SWITCHING_SWITCH1_PORT_3333_VARDIF_MAX=512
# SWITCHING_SWITCH1_PORT_3333_VARDIF_TARGET=15
# SWITCHING_SWITCH1_PORT_3333_VARDIF_RETARGET=90
# SWITCHING_SWITCH1_PORT_3333_VARDIF_VARIANCE=30

# =============================================================================
# Profit Switching Configuration
# =============================================================================
PROFIT_SWITCH_ENABLED=false
PROFIT_SWITCH_UPDATE_INTERVAL=600
PROFIT_SWITCH_DEPTH=0.90
PROFIT_SWITCH_USE_POLONIEX=true
PROFIT_SWITCH_USE_CRYPTY=true
PROFIT_SWITCH_USE_BITTREX=true
PROFIT_SWITCH_USE_MINTPAL=false

# =============================================================================
# Pool-Specific Configuration (set per pool in pool_configs/*.json)
# =============================================================================
# These are examples - actual values go in pool_configs/yourcoin.json
#
# POOL_ENABLED=true
# POOL_COIN=litecoin.json
# POOL_ADDRESS=your_pool_wallet_address
# POOL_REWARD_RECIPIENTS_OPERATOR=1.5
# POOL_REWARD_RECIPIENTS_COOWNER=0.5
#
# POOL_PAYMENT_PROCESSING_ENABLED=true
# POOL_PAYMENT_INTERVAL=30
# POOL_MINIMUM_PAYMENT=0.01
# POOL_DAEMON_HOST=127.0.0.1
# POOL_DAEMON_PORT=4000
# POOL_DAEMON_USER=rpcuser
# POOL_DAEMON_PASSWORD=rpcpassword
#
# POOL_PORT_3032_DIFF=32
# POOL_PORT_3032_VARDIF_MIN=8
# POOL_PORT_3032_VARDIF_MAX=512
# POOL_PORT_3032_VARDIF_TARGET=15
# POOL_PORT_3032_VARDIF_RETARGET=90
# POOL_PORT_3032_VARDIF_VARIANCE=30
#
# POOL_DAEMONS_0_HOST=127.0.0.1
# POOL_DAEMONS_0_PORT=4000
# POOL_DAEMONS_0_USER=rpcuser
# POOL_DAEMONS_0_PASSWORD=rpcpassword
#
# POOL_P2P_ENABLED=false
# POOL_P2P_HOST=127.0.0.1
# POOL_P2P_PORT=19333
# POOL_P2P_DISABLE_TRANSACTIONS=true